rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===========================
    // Helper Functions
    // ===========================

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Get the user's document data from Firestore
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Get the user's role from their Firestore profile
    function getUserRole() {
      return getUserData().role;
    }

    // Get the user's assigned department (for staff)
    function getUserDepartment() {
      return getUserData().department;
    }

    // Check if user is a student
    function isStudent() {
      return isAuthenticated() && getUserRole() == 'student';
    }

    // Check if user is staff
    function isStaff() {
      return isAuthenticated() && getUserRole() == 'staff';
    }

    // Check if user is staff assigned to a specific department (or assigned to 'All')
    function isStaffForDepartment(dept) {
      return isStaff() && (
        getUserDepartment() == dept ||
        getUserDepartment() == 'All'
      );
    }

    // Check if user is admin (admin role only set via Firebase Admin SDK or Console, never via frontend)
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    // Check if the requesting user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===========================
    // Users Collection
    // ===========================
    match /users/{userId} {
      // Users can read their own profile; admins can read any profile
      allow read: if isOwner(userId) || isAdmin();

      // Users can create their own profile during signup ONLY
      // Strictly disallowed: role == 'admin'
      // Allowed roles: only 'student' or 'staff'
      allow create: if isOwner(userId)
        && request.resource.data.role in ['student', 'staff']
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.campus == 'LPU Phagwara'
        && (!('department' in request.resource.data) || request.resource.data.department in ['Plumbing', 'Electrical', 'Wi-Fi', 'Mess', 'Academic', 'Other', null]);

      // Users can update limited personal profile fields (e.g. fullName)
      // PROTECTED FIELDS: role, uid, department CANNOT be modified by users
      allow update: if isOwner(userId)
        && !('role' in request.resource.data.diff(resource.data).affectedKeys())
        && !('uid' in request.resource.data.diff(resource.data).affectedKeys())
        && !('department' in request.resource.data.diff(resource.data).affectedKeys());

      // Only admins can delete user profiles
      allow delete: if isAdmin();
    }

    // ===========================
    // Complaints Collection
    // ===========================
    match /complaints/{ticketId} {
      // 1. Students can read ONLY their own complaints
      // 2. Staff can read complaints assigned to their authorized department ONLY
      // 3. Admin can read all complaints
      allow read: if isOwner(resource.data.userId)
        || isStaffForDepartment(resource.data.department)
        || isAdmin();

      // Authenticated users can create complaints for themselves only
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'Submitted'
        && request.resource.data.originalComplaint is string
        && request.resource.data.originalComplaint.size() > 0
        && request.resource.data.department in ['Plumbing', 'Electrical', 'Wi-Fi', 'Mess', 'Academic', 'Other']
        && request.resource.data.campus == 'LPU Phagwara';

      // 1. Only staff authorized for this specific department (or admin) can update complaint status
      // 2. Staff CANNOT update complaints outside their department
      // 3. PROTECTED FIELDS: userId, department, originalComplaint, ticketId are strictly immutable
      // 4. Only status, updatedAt, and staffNote may be updated
      allow update: if (isStaffForDepartment(resource.data.department) || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt', 'staffNote'])
        && request.resource.data.status in ['Submitted', 'Under Review', 'Assigned', 'In Progress', 'Resolved', 'Rejected']
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.department == resource.data.department;

      // Only admins can delete complaints
      allow delete: if isAdmin();
    }
  }
}
