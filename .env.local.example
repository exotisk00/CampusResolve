# Firebase Environment Variables — CampusResolve AI (Frontend)
# LPU Phagwara Campus

# ============================================================
# STEP 1: Create a Firebase project at https://console.firebase.google.com
# STEP 2: Add a Web App to your project
# STEP 3: Copy the firebaseConfig values below
# STEP 4: Enable Email/Password in Authentication → Sign-in method
# STEP 5: Create a Firestore database in Native mode
# ============================================================

# Public Firebase Web App configuration (safe in frontend)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend Gemini API (keep in backend .env, NOT here)
# PORT=5001
# GEMINI_API_KEY=
